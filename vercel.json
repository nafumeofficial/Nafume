{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html",               "destination": "/",             "permanent": true },
    { "source": "/pages/guides/index.html",  "destination": "/pages/guides", "permanent": true },
    { "source": "/pages/guides/index",       "destination": "/pages/guides", "permanent": true },
    { "source": "/pages/:section/:page.html","destination": "/pages/:section/:page", "permanent": true }
  ],
  "rewrites": [
    { "source": "/pages/guides",             "destination": "/pages/guides/index.html" },
    { "source": "/pages/:section/:page",     "destination": "/pages/:section/:page.html" }
  ]
}
