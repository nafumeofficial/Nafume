# ============================================================================
# NAFUME — Environment Variables
# ============================================================================
# Do NOT commit real values. Add real values in:
#   Vercel Dashboard → Project → Settings → Environment Variables
#   → select both "Production" and "Preview" environments
#   → trigger a new Vercel deployment after adding/changing values
#
# NEVER prefix these with NEXT_PUBLIC_ — they must stay server-side only.
# ============================================================================

# ── MSG91 OTP (required for phone login) ────────────────────────────────────
# Get from: https://msg91.com/ → Dashboard → API Keys
MSG91_AUTH_KEY=

# DLT-approved OTP template ID from MSG91 → Templates
# Your template MUST contain ##OTP## placeholder. Suggested text:
#   "{#var#} is your NAFUME verification code. It is valid for 5 minutes. Do not share it with anyone."
MSG91_TEMPLATE_ID=

# DLT-approved Sender ID / Header from MSG91 → Sender IDs (e.g. NAFUME)
MSG91_SENDER_ID=

# ── OTP behaviour (optional — defaults shown) ────────────────────────────────
# OTP validity window in seconds (passed to MSG91 as otp_expiry in minutes)
OTP_EXPIRY_SECONDS=300

# Cooldown between resend requests (seconds) — returned to frontend as hint
OTP_RESEND_COOLDOWN_SECONDS=30

# Max OTP send attempts per session per number (enforced client-side via sessionStorage)
OTP_MAX_SEND_ATTEMPTS=3

# Max verify attempts per session per number (enforced client-side via sessionStorage)
# Server-side per-number counting requires Vercel KV (add if needed for production hardening)
OTP_MAX_VERIFY_ATTEMPTS=5

# ── Razorpay (required for "Pay Online" checkout) ───────────────────────────
# Get from: https://dashboard.razorpay.com/ → Settings → API Keys
# Use TEST keys (rzp_test_...) first and run the full QA checklist before
# switching to LIVE keys (rzp_live_...). Only change the VALUES in Vercel
# Dashboard to go live — no code change required.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — only needed if a Razorpay webhook endpoint is added later.
# Not used by api/razorpay/create-order.js or verify-payment.js.
RAZORPAY_WEBHOOK_SECRET=
